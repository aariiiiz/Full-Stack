 import React, { useState, useMemo } from "react"; 
 
// Memoized Child Component 
const StudentList = React.memo(({ students }) => { 
  console.log("Student List Rendered"); 
 
  return ( 
    <div> 
      <h3>Student List</h3> 
      <ul> 
        {students.map((student, index) => ( 
          <li key={index}>{student}</li> 
        ))} 
      </ul> 
    </div> 
  ); 
}); 
 
